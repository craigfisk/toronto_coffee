---
import fs from 'node:fs';
import path from 'node:path';
import CoffeeMapApp from '../components/CoffeeMapApp.vue';
import { parseCoffeeData } from '../utils/parser.js';

const filePath = path.join(process.cwd(), 'toronto_coffee_with_coordinates.txt');
let rawData = '';
try {
  rawData = fs.readFileSync(filePath, 'utf-8');
} catch (e) {
  console.error('Failed to read coffee shop data file:', e);
}

const coffeeShops = parseCoffeeData(rawData);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Toronto Coffee Shop Explorer</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen">
    <CoffeeMapApp client:only="vue" initialShops={coffeeShops} />
  </body>
</html>
